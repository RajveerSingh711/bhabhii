<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bhabhi – The Last One Standing</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#efe6d2;--ink:#1d2a24;--panel:#fbf6ea;--felt:#14503a;--felt2:#0c3426;--brass:#b8892b;--red:#b3261e;--line:#d9ccae}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1a14;--ink:#f1ead7;--panel:#16251d;--line:#2c4034}}
:root[data-theme="dark"]{--bg:#0d1a14;--ink:#f1ead7;--panel:#16251d;--line:#2c4034}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;min-height:100vh}
h1,h2{font-family:Fraunces,Georgia,serif;margin:0;font-weight:900;letter-spacing:-.02em}
button{font:inherit;cursor:pointer;border:0;border-radius:10px;padding:.6rem 1.1rem;background:var(--brass);color:#1d1708;font-weight:600}
button.ghost{background:transparent;color:inherit;border:1px solid var(--line)}
button:focus-visible,.card:focus-visible{outline:3px solid var(--brass);outline-offset:2px}
input,select{font:inherit;padding:.55rem .7rem;border-radius:10px;border:1px solid var(--line);background:var(--panel);color:var(--ink);width:100%}
.wrap{max-width:980px;margin:0 auto;padding:16px}
#lobby{display:grid;gap:18px;place-items:start;padding-top:8vh}
#lobby h1{font-size:clamp(3rem,12vw,6.5rem);line-height:.9}
#lobby p{max-width:46ch;margin:0}
.box{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;display:grid;gap:12px;width:min(420px,100%)}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
#room{font-family:Fraunces,serif;font-size:1.6rem;letter-spacing:.2em}
#game{display:none}
.table{background:radial-gradient(ellipse at center,var(--felt),var(--felt2));border:6px solid #5b3b1c;border-radius:28px;padding:14px;color:#f1ead7;min-height:330px;display:grid;gap:12px}
.seats{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.seat{padding:6px 10px;border-radius:999px;background:#0006;border:2px solid transparent;font-size:.85rem;display:flex;gap:8px;align-items:center}
.seat.turn{border-color:var(--brass);background:#0009}.seat.out{opacity:.45;text-decoration:line-through}
.back{width:18px;height:26px;border-radius:3px;background:repeating-linear-gradient(45deg,#8c1d2b 0 3px,#a8323f 3px 6px);border:1px solid #fff8;display:inline-block}
.center{min-height:120px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;align-items:center}
.card{width:58px;height:84px;border-radius:7px;background:#fffdf6;color:#111;display:inline-flex;flex-direction:column;justify-content:space-between;padding:4px 6px;font-weight:700;font-size:1.05rem;line-height:1;box-shadow:0 2px 5px #0006;user-select:none;position:relative}
.card.r{color:#b3261e}.card small{font-size:.65rem;font-weight:600;position:absolute;top:-16px;left:0;right:0;text-align:center;color:#f1ead7;white-space:nowrap}
.card b{align-self:flex-end;font-size:1.7rem;font-weight:400}
.pop{animation:pop .25s ease-out}@keyframes pop{from{transform:translateY(-14px) scale(.9);opacity:0}}
@media (prefers-reduced-motion:reduce){.pop{animation:none}}
.hand{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;padding:26px 0 6px}
.hand .card{cursor:pointer;transition:transform .12s}.hand .card.ok:hover{transform:translateY(-10px)}
.hand .card.no{opacity:.4;cursor:not-allowed}.hand .card.ok{outline:2px solid var(--brass)}
#status{text-align:center;font-weight:600;min-height:1.6em}
#banner{text-align:center;font-family:Fraunces,serif;font-size:2rem;min-height:2.4rem;color:#ffd36a}
.bar{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.lead{padding:3px 12px;border-radius:999px;background:#0006;font-size:.9rem}
#log{background:var(--panel);border:1px solid var(--line);border-radius:12px;margin-top:12px;padding:10px 14px;max-height:170px;overflow:auto;font-size:.85rem}
#log div{padding:1px 0}
#result{display:none;text-align:center;display:none;gap:14px;padding-top:8vh}
#result h1{font-size:clamp(2.4rem,9vw,5rem)}
ol{text-align:left;display:inline-block;padding-left:1.5rem}
.table{position:relative}
#shuffle{position:absolute;inset:0;display:none;place-items:center;z-index:5;border-radius:22px;background:#0c3426ee}
#shuffle.on{display:grid}
#shuffle .sc{position:absolute;width:58px;height:84px;border-radius:7px;background:repeating-linear-gradient(45deg,#8c1d2b 0 4px,#a8323f 4px 8px);border:2px solid #fffdf6;box-shadow:0 2px 5px #0008;animation:riffle 1.6s ease-in-out both;animation-delay:calc(var(--i)*60ms)}
@keyframes riffle{0%{transform:translate(0,0)}25%{transform:translate(calc(var(--d)*-80px),-12px) rotate(calc(var(--d)*-9deg))}55%{transform:translate(calc(var(--d)*-80px),0) rotate(calc(var(--d)*-9deg))}80%{transform:translate(calc(var(--d)*6px),calc(var(--i)*-2px)) rotate(0)}100%{transform:translate(0,calc(var(--i)*-2px))}}
.hand .card.deal{animation:deal .55s cubic-bezier(.2,.8,.3,1) backwards;animation-delay:calc(var(--i)*55ms)}
@keyframes deal{from{transform:translateY(-260px) rotate(-14deg) scale(.55);opacity:0}}
.pop.me{animation:flyme .35s ease-out}.pop.bot{animation:flybot .35s ease-out}
@keyframes flyme{from{transform:translateY(170px) rotate(8deg) scale(.9);opacity:.3}}
@keyframes flybot{from{transform:translateY(-130px) rotate(-8deg) scale(.9);opacity:.3}}
.swd,.swu{transition:transform .55s ease-in,opacity .55s}
.swd{transform:translateY(220px) scale(.55) rotate(10deg);opacity:0}
.swu{transform:translateY(-220px) scale(.55) rotate(-10deg);opacity:0}
.seat,.hand{position:relative}
.shk{animation:shk .5s}@keyframes shk{20%{transform:translate(-8px,3px) rotate(-.6deg)}40%{transform:translate(8px,-3px) rotate(.6deg)}60%{transform:translate(-5px,2px)}80%{transform:translate(4px,-2px)}}
.table.shk::after{content:"";position:absolute;inset:0;border-radius:22px;background:radial-gradient(transparent 40%,#c1121f99);animation:redf .7s forwards;pointer-events:none}
@keyframes redf{to{opacity:0}}
.plus{position:absolute;top:-6px;left:50%;font-weight:900;color:#ffd36a;font-size:1.4rem;text-shadow:0 2px 6px #000;animation:rise 1.3s ease-out forwards;pointer-events:none;white-space:nowrap}
@keyframes rise{from{transform:translate(-50%,10px) scale(.6);opacity:0}20%{opacity:1}to{transform:translate(-50%,-48px) scale(1.4);opacity:0}}
.hit{animation:hit .6s}@keyframes hit{40%{transform:scale(1.15);filter:brightness(1.5)}}
.seat.turn{animation:glow 1.4s ease-in-out infinite}@keyframes glow{50%{box-shadow:0 0 14px 2px #ffd36a99}}
.hand .card.ok:not(.deal){animation:ready 1.6s ease-in-out infinite}@keyframes ready{50%{box-shadow:0 0 12px 2px #ffd36acc}}
.cf{position:fixed;top:-20px;width:10px;height:16px;z-index:9;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg)}}
#result h1{animation:bam .8s cubic-bezier(.2,1.6,.4,1)}
@media (prefers-reduced-motion:reduce){.cf,.plus,.shk,.hit,.seat.turn,.hand .card.ok,.table.shk::after,#result h1{animation:none!important}}
.bam{animation:bam .6s cubic-bezier(.2,1.6,.4,1)}
@keyframes bam{from{transform:scale(2.6) rotate(-6deg);opacity:0}}
@media (prefers-reduced-motion:reduce){#shuffle .sc,.deal,.bam,.pop.me,.pop.bot{animation:none!important}.swd,.swu{transition:none}}
</style></head><body>
<main class="wrap">
<section id="lobby">
 <h1>Bhabhi</h1>
 <p>Don’t be the last one holding cards. Shed your hand, dodge the Thulla, and leave someone else to be the Bhabhi.</p>
 <div class="box">
  <label>Your name<input id="name" maxlength="14" value="Player"></label>
  <label>Players at the table (you + bots)<select id="count"></select></label>
  <div class="row"><button id="create">Create room</button><button class="ghost" id="join">Join room</button><input id="code" placeholder="Room code" maxlength="5" style="width:120px"></div>
  <div id="roomInfo" hidden>
   <div>Room code <span id="room"></span></div>
   <div id="plist" class="row" style="margin:8px 0"></div>
   <button id="start">Start game</button>
  </div>
  <small id="note">Bots fill every other seat. Playing with friends online needs the Socket.IO server, which this page can’t host.</small>
 </div>
</section>
<section id="game">
 <div class="bar"><h2>Bhabhi</h2><span class="lead" id="lead">Lead suit: none</span>
  <span class="row"><button class="ghost" id="sort">Sort cards</button><button class="ghost" id="quit">Leave</button></span></div>
 <div class="table"><div id="shuffle"></div>
  <div class="seats" id="seats"></div>
  <div id="banner"></div>
  <div class="center" id="center"></div>
  <div id="status"></div>
 </div>
 <div class="hand" id="hand"></div>
 <div id="log"></div>
</section>
<section id="result"><h1 id="rtitle"></h1><div><ol id="rank"></ol></div><div><button id="again">Play again</button></div></section>
</main>
<script>
const SY={S:'♠',H:'♥',D:'♦',C:'♣'},RK={11:'J',12:'Q',13:'K',14:'A'},rk=r=>RK[r]||r;
const NAMES=['Asha','Ravi','Meera','Kabir','Divya','Imran','Lata','Vikram','Zoya','Arjun','Tara','Nikhil'];
const same=(a,b)=>a.suit===b.suit&&a.rank===b.rank;
const esc=v=>String(v).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
// ---- engine (mirrors engine.ts) ----
function createDeck(){return 'SHDC'.split('').flatMap(s=>Array.from({length:13},(_,i)=>({suit:s,rank:i+2})))}
function shuffle(d){d=[...d];for(let i=d.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[d[i],d[j]]=[d[j],d[i]]}return d}
function newGame(n){const h=Array.from({length:n},()=>[]);shuffle(createDeck()).forEach((c,i)=>h[i%n].push(c));
 const st=h.findIndex(x=>x.some(c=>c.suit==='S'&&c.rank===14));
 return{phase:'first',hands:h,active:h.map((_,i)=>i),winners:[],bhabhi:null,current:st,starter:st,lead:null,plays:[]}}
const hi=(pl,s)=>pl.filter(p=>p.card.suit===s).reduce((a,b)=>b.card.rank>a.card.rank?b:a);
function legal(s,p){const h=s.hands[p];if(s.plays.length===0)return s.phase==='first'?h.filter(c=>c.suit==='S'&&c.rank===14):h;
 const f=h.filter(c=>c.suit===s.lead);return f.length?f:h}
function elim(s){for(const p of [...s.active])if(!s.hands[p].length&&p!==s.starter){s.active=s.active.filter(x=>x!==p);s.winners.push(p);note(`${nm[p]} is out and has won!`)}}
function bhab(s,p){s.bhabhi=p;s.active=[p];s.phase='over';note(`${nm[p]} is the Bhabhi!`);return s}
function nextTurn(s,normal){s.plays=[];s.lead=null;elim(s);if(s.active.length===1)return bhab(s,s.active[0]);
 if(!s.hands[s.starter].length){
  if(s.active.length===2){
   const p2=s.active.find(x=>x!==s.starter);
   s.phase='showdown';s.showdown={p1:s.starter,p2};s.current=s.starter;
   note(`Final showdown: ${nm[s.starter]} must draw from ${nm[p2]}`);return s;
  }
  if(normal){for(const q of s.active)if(q!==s.starter&&s.hands[q].length)s.hands[s.starter].push(s.hands[q].splice(Math.floor(Math.random()*s.hands[q].length),1)[0]);
   note(`${nm[s.starter]} collected a random card from every player`);elim(s);if(s.active.length===1)return bhab(s,s.active[0])}}
 s.phase='normal';s.current=s.starter;return s}
function play(s,p,card){s.hands[p]=s.hands[p].filter(c=>!same(c,card));if(!s.plays.length)s.lead=card.suit;
 const thulla=s.phase==='normal'&&s.plays.length>0&&card.suit!==s.lead;s.plays.push({player:p,card});
 if(thulla){const h=hi(s.plays,s.lead);s.hands[h.player].push(...s.plays.map(x=>x.card));s.starter=h.player;note(`THULLA! ${nm[h.player]} collects ${s.plays.length} cards`);nextTurn(s,false);return 'thulla'}
 if(s.plays.length===s.active.length){s.starter=s.phase==='first'?s.plays[0].player:hi(s.plays,s.lead).player;nextTurn(s,true);return 'trick'}
 s.current=s.active[(s.active.indexOf(p)+1)%s.active.length];return 'go'}
// ---- bots ----
function botPick(s,p){const L=legal(s,p).sort((a,b)=>a.rank-b.rank);
 if(!s.plays.length)return L[0];
 if(L[0].suit!==s.lead)return L[L.length-1]; // can't follow: dump highest
 const top=hi(s.plays,s.lead).card.rank,under=L.filter(c=>c.rank<top);return under.length?under[under.length-1]:L[0]}
// ---- UI ----
let s,nm,busy,mine,dealing=false;const $=id=>document.getElementById(id),sleep=ms=>new Promise(r=>setTimeout(r,ms));
function note(t){const d=document.createElement('div');d.textContent=t;$('log').prepend(d)}
const cardEl=(c,cls='',who)=>{const e=document.createElement('div');e.className=`card ${'HD'.includes(c.suit)?'r':''} ${cls}`;
 e.innerHTML=`${who?`<small>${esc(who)}</small>`:''}<span>${rk(c.rank)}</span><b>${SY[c.suit]}</b>`;return e};
function fill(){const sel=$('count');for(let i=3;i<=13;i++)sel.add(new Option(i+' players',i));sel.value=4}
function roster(){const n=+$('count').value;nm=[$('name').value.trim()||'Player',...NAMES.slice(0,n-1)];
 $('plist').innerHTML=nm.map((x,i)=>`<span class="seat">${esc(x)} ${i?'(bot) ready':'(host) ready'}</span>`).join('')}
$('create').onclick=()=>{$('room').textContent=Math.random().toString(36).slice(2,7).toUpperCase();$('roomInfo').hidden=false;roster()};
$('join').onclick=()=>{$('note').textContent=$('code').value?'Joining other people’s rooms needs the multiplayer server. Create a room here to play against bots.':'Enter a room code first.'};
$('count').onchange=()=>{if(!$('roomInfo').hidden)roster()};
$('start').onclick=async()=>{roster();s=newGame(nm.length);$('lobby').style.display='none';$('result').style.display='none';$('game').style.display='block';$('log').innerHTML='';
 note(`${nm[s.starter]} holds A♠ and starts.`);await shuffleShow();dealing=true;render();dealing=false;run()};
$('sort').onclick=()=>{const o={S:0,H:1,C:2,D:3};s.hands[0].sort((a,b)=>o[a.suit]-o[b.suit]||b.rank-a.rank);render()};
$('quit').onclick=()=>location.reload();$('again').onclick=()=>location.reload();
async function shuffleShow(){const o=$('shuffle');o.innerHTML='';for(let i=0;i<12;i++){const e=document.createElement('div');e.className='sc';e.style.setProperty('--i',i);e.style.setProperty('--d',i%2?1:-1);o.append(e)}o.classList.add('on');$('status').textContent='Shuffling…';await sleep(2300);o.classList.remove('on')}
function banner(t){const b=$('banner');b.textContent=t;b.classList.remove('bam');void b.offsetWidth;if(t)b.classList.add('bam')}
function render(shown){
 $('seats').innerHTML='';nm.forEach((n,i)=>{if(!i)return;const e=document.createElement('div');
  e.dataset.i=i;e.className='seat'+(s.current===i&&s.phase!=='over'?' turn':'')+(s.winners.includes(i)?' out':'');
  e.innerHTML=`${esc(n)} <span class="back"></span>×${s.hands[i].length}`;$('seats').append(e)});
 const pl=shown||s.plays;$('center').innerHTML='';pl.forEach((p,i)=>$('center').append(cardEl(p.card,i===pl.length-1?'pop '+(p.player===0?'me':'bot'):'',nm[p.player])));
 $('lead').textContent='Lead suit: '+(s.lead?SY[s.lead]:'none yet');
 const h=$('hand');h.innerHTML='';const myTurn=(s.phase==='first'||s.phase==='normal')&&s.active.includes(0)&&s.current===0&&!busy;
 const ok=myTurn?legal(s,0):[];
 s.hands[0].forEach((c,i)=>{const e=cardEl(c,(myTurn?(ok.some(x=>same(x,c))?'ok':'no'):'')+(dealing?' deal':''));e.style.setProperty('--i',i);e.tabIndex=0;
  e.onclick=()=>{if(myTurn&&ok.some(x=>same(x,c)))act(0,c)};e.onkeydown=ev=>{if(ev.key==='Enter')e.click()};h.append(e)});
 $('status').textContent=s.winners.includes(0)?'You are out! You won!':myTurn?(s.phase==='first'&&!s.plays.length?'Your turn: lead the A♠':'Your turn'):'Waiting for other players…'}
async function act(p,c){busy=true;const lead0=s.lead,before=[...s.plays,{player:p,card:c}],r=play(s,p,c);
 if(lead0&&c.suit!==lead0)(known[p]=known[p]||new Set()).add(lead0);
 if(r==='thulla'){known[s.starter]=new Set();fresh[s.starter]=new Set(before.map(x=>x.card.suit+x.card.rank))}
 note(`${nm[p]} played ${rk(c.rank)}${SY[c.suit]}`);
 if(r!=='go'){render(before);banner(r==='thulla'?'THULLA!':'');if(r==='thulla')shake();
  if(r==='thulla'&&s.hands[0].length&&s.starter===0)$('status').textContent='You collected the pile';
  await sleep(900);document.querySelectorAll('#center .card').forEach(e=>e.classList.add(s.starter===0?'swd':'swu'));await sleep(600);banner('')}
 busy=false;render();if(r==='thulla')gain(s.starter,before.length);run()}
async function run(){if(busy)return;if(s.phase==='showdown'){await finalShowdown();return}
 while(s.phase!=='over'){if(s.active.includes(0)&&s.current===0){render();return}
  await sleep(s.active.includes(0)?700:250);const c=smartPick(s,s.current);await act(s.current,c);return}
 finish()}
// ---- smarter bots: remember who is out of a suit, avoid risky leads, never re-lead a pile they just collected ----
const known=[],fresh=[];
function smartPick(s,p){const h=s.hands[p],L=legal(s,p),cnt=x=>h.filter(c=>c.suit===x).length,
 voids=x=>s.active.filter(q=>q!==p&&known[q]&&known[q].has(x)).length,F=fresh[p]||new Set();
 if(!s.plays.length){const pick=L.map(c=>({c,v:voids(c.suit)*8+c.rank*.6+(F.has(c.suit+c.rank)?6:0)+Math.random()*2})).sort((a,b)=>a.v-b.v)[0].c;fresh[p]=new Set();return pick}
 if(L[0].suit!==s.lead)return L.map(c=>({c,v:c.rank+(4-cnt(c.suit))*2+Math.random()*1.5})).sort((a,b)=>b.v-a.v)[0].c;
 const S=[...L].sort((a,b)=>a.rank-b.rank),top=hi(s.plays,s.lead).card.rank,under=S.filter(c=>c.rank<top);
 if(s.plays.length===s.active.length-1)return S[S.length-1];
 return under.length?under[under.length-1]:S[0]}
// ---- final two-player showdown ----
async function finalShowdown(){
 if(busy||s.phase!=='showdown')return;
 busy=true;
 const {p1,p2}=s.showdown;
 note(`${nm[p1]} starts the final random-pick showdown against ${nm[p2]}.`);
 while(s.hands[p2].length){
  const index=Math.floor(Math.random()*s.hands[p2].length);
  const card=s.hands[p2].splice(index,1)[0];
  s.hands[p1].push(card);
  render([{player:p1,card}]);
  $('status').textContent=`${nm[p1]} picked ${rk(card.rank)}${SY[card.suit]}`;
  note(`${nm[p1]} randomly picked ${rk(card.rank)}${SY[card.suit]} from ${nm[p2]}.`);
  await sleep(1000);
  const sameSuit=s.hands[p2].filter(c=>c.suit===card.suit);
  const hasSmaller=sameSuit.some(c=>c.rank<card.rank);
  if(sameSuit.length===0){
   note(`${nm[p2]} cannot follow ${SY[card.suit]} — THULLA! ${nm[p1]} becomes Bhabhi.`);
   s.winners.push(p2);bhab(s,p1);break;
  }
  if(!hasSmaller){
   note(`${nm[p2]} has no smaller ${SY[card.suit]} card. ${nm[p2]} becomes Bhabhi.`);
   s.winners.push(p1);bhab(s,p2);break;
  }
  note(`${nm[p2]} still has a smaller ${SY[card.suit]} card. ${nm[p1]} must pick again.`);
  await sleep(650);
 }
 if(s.phase!=='over'){
  // If the hand runs out exactly between checks, the opponent cannot follow suit.
  s.winners.push(p2);bhab(s,p1);
 }
 busy=false;finish();
}
function shake(){const t=document.querySelector('.table');t.classList.remove('shk');void t.offsetWidth;t.classList.add('shk')}
function gain(i,n){const el=i?document.querySelector(`.seat[data-i="${i}"]`):$('hand');if(!el)return;
 const f=document.createElement('span');f.className='plus';f.textContent='+'+n+' cards';el.append(f);el.classList.add('hit');setTimeout(()=>{f.remove();el.classList.remove('hit')},1400)}
function confetti(){for(let i=0;i<60;i++){const e=document.createElement('i');e.className='cf';e.style.cssText=`left:${Math.random()*100}vw;background:hsl(${Math.random()*360} 80% 60%);animation-duration:${2+Math.random()*2}s;animation-delay:${Math.random()}s`;document.body.append(e);setTimeout(()=>e.remove(),5000)}}
function finish(){render();$('game').style.display='none';$('result').style.display='grid';
 const you=s.bhabhi===0;if(!you)confetti();$('rtitle').textContent=you?'You are the Bhabhi!':nm[s.bhabhi]+' is the Bhabhi';
 $('rank').innerHTML=[...s.winners,s.bhabhi].map((p,i)=>`<li>${esc(nm[p])}${p===0?' (you)':''}${p===s.bhabhi?' – Bhabhi':i===0?' – first out':''}</li>`).join('')}
fill();
</script></body></html>
